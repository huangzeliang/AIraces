{
  "base": "http://127.0.0.1:5000",
  "timeout": 8,

  "api": {
    "parse":            { "method": "POST", "path": "/plan/parse" },
    "confirm":          { "method": "POST", "path": "/plan/confirm" },
    "schedule_save":    { "method": "POST", "path": "/schedule/save" },
    "task_complete":    { "method": "POST", "path": "/tasks/{task_id}/complete" },
    "task_delay":       { "method": "POST", "path": "/tasks/{task_id}/delay" },
    "settings_save":    { "method": "POST", "path": "/settings/save" }
  },

  "pages": [
    { "tc": "TC-001", "name": "计划录入", "path": "/plan/input", "markers": ["raw_text", "解析计划"] },
    { "tc": "TC-011", "name": "智能排期", "path": "/schedule",   "markers": ["保存排期"] },
    { "tc": "TC-016", "name": "任务列表", "path": "/tasks",      "markers": ["完成"] },
    { "tc": "TC-026", "name": "提醒中心", "path": "/reminders",  "markers": ["提醒"] },
    { "tc": "TC-033", "name": "驾驶舱",   "path": "/dashboard",  "markers": ["完成率"] },
    { "tc": "TC-035", "name": "数据管理", "path": "/data",       "markers": ["导入"] },
    { "tc": "TC-037", "name": "系统设置", "path": "/settings",   "markers": ["theme"] }
  ],

  "selectors": {
    "raw_text":              "textarea[name='raw_text']",
    "char_counter":          ".char-count, .counter, #char-count",
    "fill_example":          "button:has-text('填充示例')",
    "parse_button":          "button:has-text('解析计划')",
    "confirm_button":        "button:has-text('确认并生成排期')",
    "save_schedule":         "button:has-text('保存排期')",
    "time_bar":              ".time-bar, .timeline-item, .schedule-bar",
    "conflict_flag":         ".conflict, [data-conflict='true']",
    "task_row":              ".task-row, tbody tr",
    "progress_slider":       "input[type='range']",
    "filter_chip":           ".chip",
    "keyword_search":        "input[name='keyword']",
    "complete_button":       "button:has-text('完成')",
    "delay_button":          "button:has-text('延期')",
    "cancel_button":         "button:has-text('取消')",
    "delay_reason":          "textarea[name='delay_reason'], input[name='delay_reason']",
    "modal":                 ".modal, .dialog, [role='dialog']",
    "modal_confirm":         ".modal button:has-text('确认'), [role='dialog'] button:has-text('确定')",
    "modal_cancel":          ".modal button:has-text('取消'), [role='dialog'] button:has-text('取消')",
    "toast":                 ".toast, .message",
    "status_tag":            ".status, .status-tag",
    "task_status_cell":      "td.status, .task-status",
    "mark_read":             "button:has-text('标记已读')",
    "mark_all_read":         "button:has-text('全部已读')",
    "badge":                 ".badge, .reminder-badge, #reminder-badge",
    "theme_toggle":          "#theme-toggle, .theme-toggle"
  },

  "ui_cases": {
    "plan_input":  "/plan/input",
    "schedule":    "/schedule",
    "tasks":       "/tasks",
    "reminders":   "/reminders",
    "settings":    "/settings"
  }
}
