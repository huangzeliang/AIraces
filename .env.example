# 大模型接入配置（可选，不填则使用本地规则引擎，功能不受影响）
#
# 使用方法：把本文件复制为 .env（同目录），填入真实 Key 后重启应用。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库，请勿把真实 Key 写进本文档。

# 登录会话密钥（可选）：不设置时使用内置的本地演示密钥。
# 多人使用或正式部署时请改为一段随机字符串，避免会话被伪造。
# SECRET_KEY=change-me-to-a-random-string


# DeepSeek（V4.1 Flash，OpenAI 兼容接口）
# API Key 获取：https://platform.deepseek.com → API Keys
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-950946ad3ceb4d4fa03aa7f1595e2c48
# 官方 API 模型名是 deepseek-flash（「V4.1 Flash」为对外叫法；V3 时代的
# deepseek-chat / deepseek-reasoner 会返回 400，请以控制台/文档给出的完整模型 ID 为准）
LLM_MODEL=deepseek-flash
